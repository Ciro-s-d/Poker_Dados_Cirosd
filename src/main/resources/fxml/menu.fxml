<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.poker_dados_cirosd.controlador.menuControlador">
   <children>
      <Button fx:id="btn_Jugar" layoutX="267.0" layoutY="216.0" mnemonicParsing="false" onAction="#onJugar" prefHeight="25.0" prefWidth="66.0" text="Jugar" />
      <Label fx:id="lbl_Titulo" layoutX="195.0" layoutY="106.0" prefHeight="60.0" prefWidth="236.0" text="POKER DE DADOS" textAlignment="CENTER" textFill="#111111">
         <font>
            <Font name="Yu Gothic UI Semibold" size="28.0" />
         </font>
      </Label>
      <Button fx:id="btn_Salir" layoutX="267.0" layoutY="279.0" mnemonicParsing="false" onAction="#onSalir" prefHeight="25.0" prefWidth="66.0" text="Salir" />


      <VBox fx:id="vboxAnteSala" alignment="CENTER" layoutX="165.0" layoutY="66.0" prefHeight="238.0" prefWidth="270.0" spacing="5.0" style="-fx-background-color: white;">
         <children>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Ingresa tu Nombre:">
               <VBox.margin>
                  <Insets right="90.0" />
               </VBox.margin>
               <font>
                  <Font name="Arial" size="13.0" />
               </font>
            </Text>
            <TextField fx:id="txtNombreJugador" promptText="Ingresa tu nombre:">
               <VBox.margin>
                  <Insets bottom="45.0" left="30.0" right="30.0" />
               </VBox.margin>
            </TextField>
            <Button fx:id="btn_Unirse" contentDisplay="TOP" mnemonicParsing="false" onAction="#onUnirse" text="Unirse">
               <VBox.margin>
                  <Insets bottom="25.0" />
               </VBox.margin></Button>
            <Button fx:id="btn_Atras" mnemonicParsing="false" onAction="#onAtras" text="Atras" />
         </children>
      </VBox>
   </children>
</AnchorPane>
