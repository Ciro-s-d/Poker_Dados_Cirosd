<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<StackPane alignment="CENTER"
           style="-fx-background-image: url('/img/menus/menu_fondo.jpg'); -fx-background-size: 100% 100%; -fx-background-position: center center; -fx-background-repeat: no-repeat;"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.poker_dados_cirosd.controlador.menuControlador">
   <children>
      <AnchorPane maxHeight="652.0" maxWidth="913.0" minHeight="652.0" minWidth="913.0" prefHeight="652.0" prefWidth="913.0"
                  style="-fx-background-color: transparent;">
         <children>
            <Label fx:id="lbl_Titulo" alignment="CENTER" layoutX="216.0" layoutY="155.0" prefHeight="76.0" prefWidth="480.0"
                   style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.85), 10, 0.4, 0, 3);"
                   text="PÓKER DE DADOS" textAlignment="CENTER" textFill="#ffd54f">
               <font>
                  <Font name="Georgia Bold" size="42.0" />
               </font>
            </Label>

            <Button fx:id="btn_Jugar" layoutX="356.0" layoutY="285.0" mnemonicParsing="false" onAction="#onJugar"
                    prefHeight="46.0" prefWidth="200.0"
                    style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-color: rgba(255,255,255,0.35); -fx-border-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 8, 0, 0, 2);"
                    text="Jugar" />

            <Button fx:id="btn_Salir" layoutX="356.0" layoutY="352.0" mnemonicParsing="false" onAction="#onSalir"
                    prefHeight="42.0" prefWidth="200.0"
                    style="-fx-background-color: rgba(30, 30, 30, 0.85); -fx-text-fill: #ffffff; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 8, 0, 0, 2);"
                    text="Salir" />

            <VBox fx:id="vboxAnteSala" alignment="CENTER" layoutX="286.0" layoutY="225.0" prefHeight="264.0" prefWidth="340.0" spacing="14.0"
                  style="-fx-background-image: url('/img/objetos/madera.jpg'); -fx-background-size: 100% 100%; -fx-background-position: center center; -fx-background-repeat: no-repeat; -fx-background-radius: 14; -fx-border-color: #ffd54f; -fx-border-radius: 14; -fx-border-width: 2; -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.55), 18, 0.25, 0, 5);">
               <children>
                  <Text fill="#ffd54f" strokeType="OUTSIDE" strokeWidth="0.0" text="Ingresá tu nombre"
                        style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.9), 7, 0.5, 0, 1);">
                     <font>
                        <Font name="System Bold" size="17.0" />
                     </font>
                  </Text>

                  <TextField fx:id="txtNombreJugador" prefHeight="38.0" prefWidth="260.0" promptText="Tu nombre de jugador..."
                             style="-fx-background-color: rgba(255, 248, 225, 0.95); -fx-text-fill: #2b1508; -fx-prompt-text-fill: #6d4c41; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-color: #4e2c15; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-padding: 6 12 6 12; -fx-font-size: 14px;">
                     <VBox.margin>
                        <Insets bottom="6.0" left="10.0" right="10.0" />
                     </VBox.margin>
                  </TextField>

                  <Button fx:id="btn_Unirse" contentDisplay="TOP" mnemonicParsing="false" onAction="#onUnirse"
                          prefHeight="40.0" prefWidth="200.0"
                          style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-color: #ffe082; -fx-border-width: 1; -fx-border-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 6, 0, 0, 2);"
                          text="Unirse" />

                  <Button fx:id="btn_Atras" mnemonicParsing="false" onAction="#onAtras"
                          prefHeight="36.0" prefWidth="200.0"
                          style="-fx-background-color: #3e2210; -fx-text-fill: #fff8e1; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-color: #d4af37; -fx-border-width: 1; -fx-border-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 6, 0, 0, 2);"
                          text="Atrás" />
               </children>
            </VBox>
         </children>
      </AnchorPane>
   </children>
</StackPane>