<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="391.0" prefWidth="322.0" style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.poker_dados_cirosd.controlador.salaControlador">
    <VBox alignment="CENTER" fillWidth="false" layoutX="23.0" layoutY="14.0" maxHeight="380.0" maxWidth="420.0"
          prefHeight="359.0" prefWidth="278.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Sala de Espera">
            <font>
                <Font size="14.0"/>
            </font>
            <VBox.margin>
                <Insets bottom="25.0"/>
            </VBox.margin>
        </Text>
        <TableView fx:id="tablaJugadores" prefHeight="254.0" prefWidth="222.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="55.0" text="ID"/>
                <TableColumn fx:id="colNombre" prefWidth="164.0" text="NOMBRE"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <VBox.margin>
                <Insets bottom="30.0"/>
            </VBox.margin>
        </TableView>
        <Label fx:id="lblEsperando" text="Esperando que el admin inicie partida...">
            <VBox.margin>
                <Insets top="30.0"/>
            </VBox.margin>
        </Label>
        <Button fx:id="btnIniciarPartida" mnemonicParsing="false" onAction="#onIniciarPartida"
                text="INICIAR PARTIDA">
            <VBox.margin>
                <Insets bottom="20.0"/>
            </VBox.margin>
        </Button>
    </VBox>
</AnchorPane>
