<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<StackPane alignment="CENTER"
           style="-fx-background-color: #eceff1;"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.poker_dados_cirosd.controlador.salaControlador">
    <children>
        <AnchorPane maxHeight="520.0" maxWidth="460.0" minHeight="520.0" minWidth="460.0" prefHeight="520.0" prefWidth="460.0"
                    style="-fx-background-color: #ffffff; -fx-background-radius: 16; -fx-border-color: #cfd8dc; -fx-border-radius: 16; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 18, 0, 0, 4);">
            <VBox alignment="CENTER" fillWidth="false" spacing="18.0"
                  AnchorPane.bottomAnchor="24.0" AnchorPane.leftAnchor="24.0" AnchorPane.rightAnchor="24.0" AnchorPane.topAnchor="24.0">
                <Text fill="#1b3b2b" strokeType="OUTSIDE" strokeWidth="0.0" text="Sala de Espera">
                    <font>
                        <Font name="Georgia Bold" size="26.0" />
                    </font>
                </Text>

                <TableView fx:id="tablaJugadores" prefHeight="270.0" prefWidth="360.0"
                           style="-fx-background-radius: 10; -fx-border-color: #cfd8dc; -fx-border-radius: 10;">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="80.0" text="ID" />
                        <TableColumn fx:id="colNombre" prefWidth="278.0" text="NOMBRE" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <Label fx:id="lblEsperando" text="Esperando que el admin inicie la partida..."
                       style="-fx-text-fill: #546e7a; -fx-font-size: 14px; -fx-font-style: italic;">
                    <VBox.margin>
                        <Insets top="4.0" />
                    </VBox.margin>
                </Label>

                <Button fx:id="btnIniciarPartida" mnemonicParsing="false" onAction="#onIniciarPartida"
                        prefHeight="44.0" prefWidth="220.0"
                        style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="INICIAR PARTIDA" />
            </VBox>
        </AnchorPane>
    </children>
</StackPane>