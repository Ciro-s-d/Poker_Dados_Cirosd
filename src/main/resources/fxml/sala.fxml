<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<StackPane alignment="CENTER"
           style="-fx-background-image: url('/img/menus/sala_fondo.jpg'); -fx-background-size: 100% 100%; -fx-background-position: center center; -fx-background-repeat: no-repeat;"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.poker_dados_cirosd.controlador.salaControlador">
    <children>
        <AnchorPane maxHeight="560.0" maxWidth="520.0" minHeight="560.0" minWidth="520.0" prefHeight="560.0" prefWidth="520.0"
                    style="-fx-background-color: transparent;">
            <VBox alignment="CENTER" fillWidth="false" spacing="16.0"
                  AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
                <Text fill="#ffd54f" strokeType="OUTSIDE" strokeWidth="0.0" text="Sala de Espera"
                      style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.85), 8, 0.4, 0, 2);">
                    <font>
                        <Font name="Georgia Bold" size="28.0" />
                    </font>
                </Text>

                <!-- Contenedor de la lista con imagen de hoja de fondo -->
                <StackPane alignment="CENTER" prefHeight="330.0" prefWidth="380.0"
                           style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 14, 0, 0, 4);">
                    <children>
                        <ImageView fx:id="imgHojaSala" fitHeight="330.0" fitWidth="380.0" pickOnBounds="true" preserveRatio="false">
                            <image>
                                <Image url="@../img/objetos/hoja_sala.jpg" />
                            </image>
                        </ImageView>

                        <TableView fx:id="tablaJugadores" prefHeight="286.0" prefWidth="346.0"
                                   style="-fx-background-color: transparent; -fx-control-inner-background: transparent; -fx-border-color: #8d6e4c; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6;">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="68.0" text="ID" />
                                <TableColumn fx:id="colNombre" prefWidth="264.0" text="NOMBRE" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </StackPane>

                <Label fx:id="lblEsperando" text="Esperando que el admin inicie la partida..."
                       style="-fx-text-fill: #ffffff; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: rgba(0,0,0,0.55); -fx-background-radius: 8; -fx-padding: 6 14 6 14;">
                    <VBox.margin>
                        <Insets top="2.0" />
                    </VBox.margin>
                </Label>

                <Button fx:id="btnIniciarPartida" mnemonicParsing="false" onAction="#onIniciarPartida"
                        prefHeight="44.0" prefWidth="220.0"
                        style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-color: rgba(255,255,255,0.35); -fx-border-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 8, 0, 0, 2);"
                        text="INICIAR PARTIDA" />
            </VBox>
        </AnchorPane>
    </children>
</StackPane>