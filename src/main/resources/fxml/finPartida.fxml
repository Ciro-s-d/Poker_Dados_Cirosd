<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane alignment="CENTER"
           style="-fx-background-color: #eceff1;"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.poker_dados_cirosd.controlador.finPartidaControlador">
    <children>
        <VBox alignment="CENTER"
              maxHeight="560.0"
              maxWidth="760.0"
              minHeight="560.0"
              minWidth="760.0"
              prefHeight="560.0"
              prefWidth="760.0"
              spacing="24.0"
              style="-fx-background-color: #ffffff; -fx-border-color: #cfd8dc; -fx-border-width: 1.5; -fx-border-radius: 16; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 18, 0, 0, 4);">
            <padding>
                <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
            </padding>
            <children>
                <Label text="Fin de partida" textFill="#1b3b2b">
                    <font>
                        <Font name="Georgia Bold" size="36.0" />
                    </font>
                </Label>

                <Label style="-fx-text-fill: #2e7d32;" text="EL GANADOR ES:">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>

                <HBox alignment="CENTER"
                      maxWidth="500.0"
                      spacing="22.0"
                      style="-fx-background-color: #f8fafb; -fx-border-color: #b0bec5; -fx-border-width: 1.5; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 20;">
                    <children>
                        <ImageView fx:id="imgGanador"
                                   fitHeight="92.0"
                                   fitWidth="92.0"
                                   preserveRatio="true" />

                        <VBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label fx:id="lblNombreGanador" text="Nombre" textFill="#1b3b2b">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>
                                <Label fx:id="lblFichasGanador" style="-fx-text-fill: #455a64;" text="Fichas: 0">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Button fx:id="btnVolverMenu"
                        onAction="#onVolverMenu"
                        prefHeight="44.0"
                        prefWidth="240.0"
                        style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="Volver al menú principal" />
            </children>
        </VBox>
    </children>
</StackPane>