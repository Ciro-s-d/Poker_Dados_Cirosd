<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane alignment="CENTER"
           style="-fx-background-image: url('/img/menus/finpartida_fondo.jpg'); -fx-background-size: 100% 100%; -fx-background-position: center center; -fx-background-repeat: no-repeat;"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.poker_dados_cirosd.controlador.finPartidaControlador">
    <children>
        <VBox alignment="CENTER"
              maxHeight="560.0"
              maxWidth="760.0"
              minHeight="560.0"
              minWidth="760.0"
              prefHeight="560.0"
              prefWidth="760.0"
              spacing="22.0"
              style="-fx-background-color: transparent;">
            <padding>
                <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
            </padding>
            <children>
                <Label text="Fin de partida"
                       textFill="#ffd54f"
                       style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.9), 10, 0.5, 0, 3);">
                    <font>
                        <Font name="Georgia Bold" size="38.0" />
                    </font>
                </Label>

                <Label text="EL GANADOR ES:"
                       textFill="#81c784"
                       style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.9), 8, 0.45, 0, 2);">
                    <font>
                        <Font name="System Bold" size="21.0" />
                    </font>
                </Label>

                <!-- Bloque del ganador con fondo de madera: [FOTO] [NOMBRE] [FICHAS] -->
                <HBox alignment="CENTER"
                      maxWidth="520.0"
                      prefWidth="520.0"
                      spacing="22.0"
                      style="-fx-background-image: url('/img/objetos/madera.jpg'); -fx-background-size: 100% 100%; -fx-background-position: center center; -fx-background-repeat: no-repeat; -fx-border-color: #ffd54f; -fx-border-width: 2; -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 16, 0.25, 0, 5);">
                    <children>
                        <ImageView fx:id="imgGanador"
                                   fitHeight="92.0"
                                   fitWidth="92.0"
                                   preserveRatio="true" />

                        <VBox alignment="CENTER_LEFT"
                              spacing="8.0"
                              style="-fx-background-color: rgba(32, 14, 6, 0.68); -fx-background-radius: 10; -fx-border-color: rgba(255, 213, 79, 0.35); -fx-border-radius: 10; -fx-padding: 10 16 10 16;">
                            <children>
                                <Label fx:id="lblNombreGanador"
                                       text="Nombre"
                                       textFill="#ffd54f"
                                       style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.85), 6, 0.4, 0, 1);">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>
                                <Label fx:id="lblFichasGanador"
                                       text="Fichas: 0"
                                       textFill="#fff8e1"
                                       style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.85), 6, 0.4, 0, 1);">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Button fx:id="btnVolverMenu"
                        onAction="#onVolverMenu"
                        prefHeight="44.0"
                        prefWidth="240.0"
                        style="-fx-background-color: #2e7d32; -fx-text-fill: #ffffff; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-color: #ffe082; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 10, 0.2, 0, 3);"
                        text="Volver al menú principal" />
            </children>
        </VBox>
    </children>
</StackPane>